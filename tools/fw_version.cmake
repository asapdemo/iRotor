# Generates fw_version.h from git. Runs on every build (see CMakeLists.txt).
#
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> -P tools/fw_version.cmake
#
# Version source of truth is the git tag "vMAJOR.MINOR.PATCH" (SemVer).
#   on the tag, clean tree   -> "v1.2.0"
#   3 commits after the tag  -> "v1.2.0-3-g6425200"
#   uncommitted changes      -> "...-dirty"
#   no tag at all            -> 0.0.0 and the short hash
# The header is rewritten only when its content changes (build time has minute resolution).

set(describe "")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(
        COMMAND ${GIT_EXECUTABLE} describe --tags --dirty --always --match "v[0-9]*"
        WORKING_DIRECTORY ${SOURCE_DIR}
        OUTPUT_VARIABLE describe
        RESULT_VARIABLE git_result
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    if(NOT git_result EQUAL 0)
        set(describe "")
    endif()
endif()
if(describe STREQUAL "")
    set(describe "unknown")
endif()

set(major 0)
set(minor 0)
set(patch 0)
if(describe MATCHES "^v([0-9]+)\\.([0-9]+)\\.([0-9]+)")
    set(major ${CMAKE_MATCH_1})
    set(minor ${CMAKE_MATCH_2})
    set(patch ${CMAKE_MATCH_3})
endif()

# Must fit FwInfo_t.git[40] including the NUL.
string(LENGTH "${describe}" describe_length)
if(describe_length GREATER 39)
    string(SUBSTRING "${describe}" 0 39 describe)
endif()

string(TIMESTAMP build_time "%Y-%m-%d %H:%M")

set(content "/* Generated by tools/fw_version.cmake -- do not edit. */
#ifndef FW_VERSION_H
#define FW_VERSION_H
#define FW_VERSION_MAJOR ${major}U
#define FW_VERSION_MINOR ${minor}U
#define FW_VERSION_PATCH ${patch}U
#define FW_GIT_DESCRIBE \"${describe}\"
#define FW_BUILD_TIME \"${build_time}\"
#endif
")

set(previous "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
    message(STATUS "Firmware version ${major}.${minor}.${patch} (${describe}), built ${build_time}")
endif()
